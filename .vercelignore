# Ignore all Python files
*.py
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/

# Ignore Python virtual environment
venv/
env/

# Ignore config files
.env
.env.local
.env.*.local
pyproject.toml

# Ignore logs and cache
logs/
.spotify_cache
.cache
*.log

# Ignore git and CI
.git/
.github/
.gitignore

# Ignore development files
data/
.vercelignore
